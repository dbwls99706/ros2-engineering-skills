diff -ruN a/src/cpp/rtps/reader/ReaderListenerGate.hpp b/src/cpp/rtps/reader/ReaderListenerGate.hpp
--- a/src/cpp/rtps/reader/ReaderListenerGate.hpp	1970-01-01 00:00:00.000000000 +0000
+++ b/src/cpp/rtps/reader/ReaderListenerGate.hpp	2026-10-20 02:35:04.017564044 +0000
@@ -0,0 +1,112 @@
+/**
+ * @file ReaderListenerGate.hpp
+ *
+ * Diagnostic change (not upstream): keeps a reader listener valid for the whole duration of
+ * every call made through it.
+ *
+ * RTPSReader::setListener() blocks new calls and waits until calls already in progress have
+ * returned. Once it returns, the previous listener, and anything that listener reaches, is no
+ * longer used by any thread. DataReaderImpl relies on this: disable() clears the listener before
+ * stop() deletes the timers and the reader that listener callbacks touch.
+ *
+ * The state lives in a table keyed by reader, so no public class layout changes.
+ */
+
+#ifndef FASTRTPS_RTPS_READER_READERLISTENERGATE_HPP_
+#define FASTRTPS_RTPS_READER_READERLISTENERGATE_HPP_
+
+#include <condition_variable>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+
+namespace eprosima {
+namespace fastrtps {
+namespace rtps {
+
+class RTPSReader;
+class ReaderListener;
+
+namespace listener_gate {
+
+struct State
+{
+    //! Serializes listener replacement.
+    std::mutex setter;
+    //! Protects the members below. Never held while a listener is called.
+    std::mutex mutex;
+    std::condition_variable idle;
+    ReaderListener* listener = nullptr;
+    uint32_t calls_in_progress = 0;
+    bool replacing = false;
+};
+
+void attach(
+        const RTPSReader* reader,
+        ReaderListener* listener);
+
+void detach(
+        const RTPSReader* reader);
+
+std::shared_ptr<State> find(
+        const RTPSReader* reader);
+
+//! Returns the listener and counts a call in progress, or nullptr when no call may start.
+ReaderListener* begin_call(
+        State& state);
+
+void end_call(
+        State& state);
+
+/**
+ * Blocks new calls, waits for calls in progress, then installs target, also in legacy_field.
+ * Aborts when called from inside a call to the same reader's listener: waiting would deadlock,
+ * and not waiting would let that call outlive the replacement.
+ */
+void replace(
+        State& state,
+        ReaderListener* target,
+        ReaderListener*& legacy_field);
+
+ReaderListener* current(
+        State& state);
+
+/**
+ * Calls f(listener) if the reader has a listener, keeping that listener in use until f returns,
+ * including when f throws.
+ */
+template<typename Functor>
+void with_listener(
+        const RTPSReader* reader,
+        Functor&& f)
+{
+    std::shared_ptr<State> state = find(reader);
+    if (!state)
+    {
+        return;
+    }
+    ReaderListener* listener = begin_call(*state);
+    if (nullptr == listener)
+    {
+        return;
+    }
+    struct EndCall
+    {
+        State& state;
+
+        ~EndCall()
+        {
+            end_call(state);
+        }
+
+    }
+    end_call_on_exit{*state};
+    f(listener);
+}
+
+} // namespace listener_gate
+} // namespace rtps
+} // namespace fastrtps
+} // namespace eprosima
+
+#endif // FASTRTPS_RTPS_READER_READERLISTENERGATE_HPP_
