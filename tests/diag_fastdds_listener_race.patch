+// Never destroyed: readers can be deleted during static destruction at process exit.
+std::mutex& table_mutex()
+{
+    static std::mutex* instance = new std::mutex();
+    return *instance;
+}
+
+std::unordered_map<const RTPSReader*, std::shared_ptr<State>>& table()
+{
+    static auto* instance = new std::unordered_map<const RTPSReader*, std::shared_ptr<State>>();
+    return *instance;
+}
+
+// Gates whose listener this thread is calling right now, innermost last.
+std::vector<const State*>& calls_on_this_thread()
+{
+    thread_local std::vector<const State*> calls;
+    return calls;
+}
+
+} // namespace
+
+void attach(
+        const RTPSReader* reader,
+        ReaderListener* listener)
+{
+    auto state = std::make_shared<State>();
+    state->listener = listener;
+    std::lock_guard<std::mutex> guard(table_mutex());
+    table()[reader] = std::move(state);
+}
+
+void detach(
+        const RTPSReader* reader)
+{
+    std::lock_guard<std::mutex> guard(table_mutex());
+    table().erase(reader);
+}
+
+std::shared_ptr<State> find(
+        const RTPSReader* reader)
+{
+    std::lock_guard<std::mutex> guard(table_mutex());
+    auto it = table().find(reader);
+    return it == table().end() ? nullptr : it->second;
+}
+
+ReaderListener* begin_call(
+        State& state)
+{
+    ReaderListener* listener = nullptr;
+    {
+        std::lock_guard<std::mutex> guard(state.mutex);
+        if (state.replacing || nullptr == state.listener)
+        {
+            return nullptr;
+        }
+        ++state.calls_in_progress;
+        listener = state.listener;
+    }
+    calls_on_this_thread().push_back(&state);
+    return listener;
+}
+
+void end_call(
+        State& state)
+{
+    auto& calls = calls_on_this_thread();
+    auto it = std::find(calls.rbegin(), calls.rend(), &state);
+    if (it != calls.rend())
+    {
+        calls.erase(std::next(it).base());
+    }
+    std::lock_guard<std::mutex> guard(state.mutex);
+    if (0 == --state.calls_in_progress)
+    {
+        state.idle.notify_all();
+    }
+}
+
+void replace(
+        State& state,
+        ReaderListener* target,
+        ReaderListener*& legacy_field)
+{
+    const auto& calls = calls_on_this_thread();
+    if (std::find(calls.begin(), calls.end(), &state) != calls.end())
+    {
+        std::fprintf(stderr, "[listener_gate] setListener() called from inside the same reader's listener\n");
+        std::abort();
+    }
+    std::lock_guard<std::mutex> setter(state.setter);
+    std::unique_lock<std::mutex> lock(state.mutex);
+    state.replacing = true;
+    state.idle.wait(lock, [&state]()
+            {
+                return 0 == state.calls_in_progress;
+            });
+    state.listener = target;
+    legacy_field = target;
+    state.replacing = false;
+}
+
+ReaderListener* current(
+        State& state)
+{
+    std::lock_guard<std::mutex> guard(state.mutex);
+    return state.listener;
+}
+
