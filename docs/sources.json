    {"id":"humble-imu-covariance","url":"https://github.com/ros2/common_interfaces/blob/humble/sensor_msgs/msg/Imu.msg","reviewed_on":"2026-09-10","review_after":"2026-12-09","covers":["references/message-types.md"],"claims":["All-zero IMU covariance means unknown uncertainty; first element -1 means unavailable measurement."]},
    {"id":"humble-pose-covariance","url":"https://github.com/ros2/common_interfaces/blob/humble/geometry_msgs/msg/PoseWithCovariance.msg","reviewed_on":"2026-09-10","review_after":"2026-12-09","covers":["references/message-types.md"],"claims":["PoseWithCovariance defines the 6x6 layout without the IMU sentinel conventions."]},
    {"id":"humble-quaternion-default","url":"https://github.com/ros2/common_interfaces/blob/humble/geometry_msgs/msg/Quaternion.msg","reviewed_on":"2026-09-10","review_after":"2026-12-09","covers":["references/message-types.md"],"claims":["The Humble message defaults to identity in x,y,z,w order."]},
    {"id":"foxy-quaternion-default","url":"https://github.com/ros2/common_interfaces/blob/foxy/geometry_msgs/msg/Quaternion.msg","reviewed_on":"2026-09-10","review_after":"2026-12-09","covers":["references/message-types.md"],"claims":["The Foxy message also defaults to identity in x,y,z,w order."]},
    {"id":"humble-image-layout","url":"https://github.com/ros2/common_interfaces/blob/humble/sensor_msgs/msg/Image.msg","reviewed_on":"2026-09-10","review_after":"2026-12-09","covers":["references/message-types.md"],"claims":["Image.step is the full row length including any padding, and data size is step times height."]},
    {"id":"humble-camera-info","url":"https://github.com/ros2/common_interfaces/blob/humble/sensor_msgs/msg/CameraInfo.msg","reviewed_on":"2026-09-10","review_after":"2026-12-09","covers":["references/message-types.md"],"claims":["A monocular projection matrix normally matches K but processed-image intrinsics may differ."]},
    {"id":"rep-117-distance-values","url":"https://github.com/ros-infrastructure/rep/blob/master/rep-0117.rst","reviewed_on":"2026-09-10","review_after":"2026-12-09","covers":["references/message-types.md"],"claims":["Distance sensors use negative infinity for too close, NaN for erroneous, and positive infinity for no return."]},
    {"id":"rep-118-depth-images","url":"https://github.com/ros-infrastructure/rep/blob/master/rep-0118.rst","reviewed_on":"2026-09-10","review_after":"2026-12-09","covers":["references/message-types.md"],"claims":["Canonical depth images use float meters; the optional OpenNI raw representation uses uint16 millimeters."]},
    {"id":"ros2-dds-security-design","url":"https://design.ros2.org/articles/ros2_dds_security.html","reviewed_on":"2026-09-10","review_after":"2026-12-09","covers":["references/security.md","references/deployment.md"],"claims":["Security files and permissions belong to DDS participants, which map to ROS contexts in processes; enclave paths are selected deployment identities."]},
    {"id":"jazzy-sros2-enclave","url":"https://github.com/ros2/sros2/blob/jazzy/sros2/sros2/keystore/_enclave.py","reviewed_on":"2026-09-10","review_after":"2026-12-09","covers":["references/security.md"],"claims":["create_enclave preserves an existing cert.pem and key.pem instead of rotating them."]},
    {"id":"jazzy-sros2-certificates","url":"https://github.com/ros2/sros2/blob/jazzy/sros2/sros2/_utilities.py","reviewed_on":"2026-09-10","review_after":"2026-12-09","covers":["references/security.md"],"claims":["The generated certificate validity default is 3650 days."]},
    {"id":"jazzy-sros2-permissions-signing","url":"https://github.com/ros2/sros2/blob/jazzy/sros2/sros2/keystore/_permission.py","reviewed_on":"2026-09-10","review_after":"2026-12-09","covers":["references/security.md"],"claims":["Permissions are signed with permissions_ca.cert.pem and permissions_ca.key.pem."]},
    {"id":"jazzy-rcl-security","url":"https://github.com/ros2/rcl/blob/jazzy/rcl/src/rcl/security.c","reviewed_on":"2026-09-10","review_after":"2026-12-09","covers":["references/security.md","references/safety-estop.md","references/deployment.md"],"claims":["Permissive may fall back to an unsecured participant when security-file initialization fails; Enforce rejects initialization."]},
    {"id":"humble-domain-id","url":"https://github.com/ros2/ros2_documentation/blob/humble/source/Concepts/Intermediate/About-Domain-ID.rst","reviewed_on":"2026-09-10","review_after":"2026-12-09","covers":["references/security.md"],"claims":["The DDS-derived ROS domain ID range is 0 through 232 inclusive, subject to platform port constraints."]},
    {"id":"python-quaternion-product","url":"https://github.com/DLu/tf_transformations/blob/main/tf_transformations/__init__.py","reviewed_on":"2026-09-10","review_after":"2026-12-09","covers":["references/message-types.md"],"claims":["quaternion_multiply performs a product without normalization."]},
    {"id":"ros2-launch-migration-rolling","url":"https://github.com/ros2/ros2_documentation/blob/rolling/source/Migration-and-Upgrades/Migrating-from-ROS1/Migrating-Launch-Files.rst","reviewed_on":"2026-09-30","review_after":"2026-12-29","covers":["references/launch-system.md","references/migration-ros1.md"],"claims":["For typical use cases, XML and YAML should be preferred over Python.","Boolean predicates can be expressed with the equals, not-equals, and, or, any, and all substitutions."]},
    {"id":"ros2-launch-migration-humble","url":"https://docs.ros.org/en/humble/How-To-Guides/Migrating-from-ROS1/Migrating-Launch-Files.html","reviewed_on":"2026-09-30","review_after":"2026-12-29","covers":["references/launch-system.md","references/migration-ros1.md"],"claims":["For typical use cases, XML and YAML should be preferred over Python.","ROS 2 XML uses exec, namespace, $(var), $(find-pkg-share), $(command), <param from>, and <push-ros-namespace>."]},
    {"id":"ros2-launch-formats-jazzy","url":"https://docs.ros.org/en/jazzy/How-To-Guides/Launch-file-different-formats.html","reviewed_on":"2026-09-30","review_after":"2026-12-29","covers":["references/launch-system.md"],"claims":["For most applications the launch format is developer preference; Python is for flexibility XML or YAML cannot achieve."]},
    {"id":"roslaunch-xml-design","url":"https://design.ros2.org/articles/roslaunch_xml.html","reviewed_on":"2026-09-30","review_after":"2026-12-29","covers":["references/launch-system.md"],"claims":["A declarative description is easier to read, audit, and maintain."]},
    {"id":"launch-boolean-substitutions","url":"https://github.com/ros2/launch/blob/humble/launch/launch/substitutions/boolean_substitution.py","reviewed_on":"2026-09-30","review_after":"2026-12-29","covers":["references/launch-system.md"],"claims":["NotSubstitution, AndSubstitution, OrSubstitution, AnySubstitution, and AllSubstitution are exposed to the frontends on the humble branch."]},
    {"id":"launch-xml-description-source","url":"https://github.com/ros2/launch/blob/humble/launch_xml/launch_xml/launch_description_sources/__init__.py","reviewed_on":"2026-09-30","review_after":"2026-12-29","covers":["references/launch-system.md"],"claims":["XMLLaunchDescriptionSource lives in launch_xml.launch_description_sources; YAMLLaunchDescriptionSource in launch_yaml.launch_description_sources."]},
    {"id":"launch-any-description-source","url":"https://github.com/ros2/launch/blob/humble/launch/launch/launch_description_sources/any_launch_description_source.py","reviewed_on":"2026-09-30","review_after":"2026-12-29","covers":["references/launch-system.md"],"claims":["AnyLaunchDescriptionSource selects by extension; specific subclasses are recommended when possible."]},
    {"id":"ros2launch-print-option","url":"https://github.com/ros2/launch_ros/blob/humble/ros2launch/ros2launch/command/launch.py","reviewed_on":"2026-09-30","review_after":"2026-12-29","covers":["references/launch-system.md","scripts/launch_validator.py"],"claims":["-p, --print, and --print-description print the launch description without launching it; --show-args lists arguments."]},
    {"id":"launch-on-process-exit","url":"https://github.com/ros2/launch/blob/humble/launch/launch/event_handlers/on_process_exit.py","reviewed_on":"2026-09-30","review_after":"2026-12-29","covers":["references/launch-system.md"],"claims":["on_exit accepts a callable receiving (ProcessExited, LaunchContext); ProcessExited carries returncode."]},
    {"id":"ros2-control-spawner-humble","url":"https://github.com/ros-controls/ros2_control/blob/humble/controller_manager/doc/userdoc.rst","reviewed_on":"2026-09-30","review_after":"2026-12-29","covers":["references/launch-system.md"],"claims":["spawner accepts several controller_names, --controller-manager-timeout, --service-call-timeout, --switch-timeout, and --activate-as-group."]},
    {"id":"rclpy-signal-options","url":"https://github.com/ros2/rclpy/blob/humble/rclpy/rclpy/__init__.py","reviewed_on":"2026-09-30","review_after":"2026-12-29","covers":["references/nodes-executors.md"],"claims":["rclpy.init accepts signal_handler_options (NO or ALL); shutdown can uninstall the handlers."]},
    {"id":"rclpy-external-shutdown","url":"https://github.com/ros2/rclpy/blob/humble/rclpy/rclpy/executors.py","reviewed_on":"2026-09-30","review_after":"2026-12-29","covers":["references/nodes-executors.md"],"claims":["The executor raises ExternalShutdownException when the context is shut down elsewhere."]},
    {"id":"rosbag2-writer-close","url":"https://github.com/ros2/rosbag2/blob/humble/rosbag2_cpp/src/rosbag2_cpp/writers/sequential_writer.cpp","reviewed_on":"2026-09-30","review_after":"2026-12-29","covers":["references/debugging.md"],"claims":["SequentialWriter::close finalizes and writes metadata.yaml; the destructor calls close."]},
    {"id":"rosbag2-default-storage","url":"https://github.com/ros2/rosbag2/blob/iron/rosbag2_storage/src/rosbag2_storage/default_storage_id.cpp","reviewed_on":"2026-09-30","review_after":"2026-12-29","covers":["references/debugging.md"],"claims":["The default storage id is sqlite3 on Humble and mcap from Iron onward."]},
    {"id":"isaac-ros-5-release-notes","url":"https://nvidia-isaac-ros.github.io/v/release-5.0/releases/index.html","reviewed_on":"2026-10-17","review_after":"2027-01-15","covers":["references/perception.md","references/simulation.md","references/communication.md","references/engineering-principles.md"],"claims":["Isaac ROS 5.0.0 (2026-09-21) moved to ROS 2 Lyrical, rebuilt the accelerated path on rosidl::Buffer with a CUDA buffer backend, removed the NITROS packages, and keeps isaac_ros_nitros_bridge_ros2 only as deprecated.","5.0 adds an Isaac ROS apt build farm with Lyrical packages for Ubuntu 24.04."]},
    {"id":"isaac-ros-nitros-migration","url":"https://nvidia-isaac-ros.github.io/v/release-5.0/concepts/rosidl_buffer/nitros_migration.html","reviewed_on":"2026-10-17","review_after":"2027-01-15","covers":["references/simulation.md","references/communication.md"],"claims":["Migrated Isaac ROS nodes keep their supported node interfaces; custom code using NITROS APIs or types needs a source-level migration."]},
    {"id":"isaac-ros-cuda-buffer-backend","url":"https://nvidia-isaac-ros.github.io/v/release-5.0/concepts/rosidl_buffer/cuda_buffer_backend.html","reviewed_on":"2026-10-17","review_after":"2027-01-15","covers":["references/communication.md"],"claims":["The CUDA backend is an advanced interface; prefer a conversion package. Handles carry synchronization and lifetime, subscriber pointers are read-only, and zero-copy needs the same host, GPU, and user, else CPU transport."]},
    {"id":"isaac-ros-conversion-packages","url":"https://nvidia-isaac-ros.github.io/v/release-5.0/concepts/rosidl_buffer/conversion_packages.html","reviewed_on":"2026-10-17","review_after":"2027-01-15","covers":["references/communication.md"],"claims":["torch_conversions and tensor_msgs/msg/ExperimentalTensor are experimental upstream interfaces."]},
    {"id":"isaac-ros-5-packages","url":"https://nvidia-isaac-ros.github.io/v/release-5.0/repositories_and_packages/index.html","reviewed_on":"2026-10-17","review_after":"2027-01-15","covers":["references/perception.md"],"claims":["The 5.0 Visual SLAM package is isaac_ros_cuvslam; Object Detection packages include isaac_ros_rtdetr, isaac_ros_yolov8, and isaac_ros_detectnet; isaac_ros_apriltag is listed; isaac_ros_depth_segmentation is not."]},
    {"id":"lyrical-release-notes","url":"https://github.com/ros2/ros2_documentation/blob/lyrical/source/Releases/Release-Lyrical-Luth.rst","reviewed_on":"2026-10-17","review_after":"2027-01-15","covers":["references/communication.md","references/engineering-principles.md"],"claims":["uint8[] fields are rosidl::Buffer<uint8_t> in C++ instead of std::vector<uint8_t>; rmw_fastrtps_cpp and rmw_zenoh_cpp are named for the feature."]},
    {"id":"lyrical-using-buffer-backends","url":"https://github.com/ros2/ros2_documentation/blob/lyrical/source/ROS-Framework/interfaces/Working-with-interfaces/Buffer-Backends/Using-Buffer-Backends.rst","reviewed_on":"2026-10-17","review_after":"2027-01-15","covers":["references/communication.md"],"claims":["Subscriptions opt in through acceptable_buffer_backends; other peers get CPU serialization. Topics only. get_backend_type() reports the received backend. CUDA zero-copy is for volatile live samples and not across hosts."]},
    {"id":"lyrical-about-buffer-backends","url":"https://github.com/ros2/ros2_documentation/blob/lyrical/source/ROS-Framework/interfaces/Working-with-interfaces/Buffer-Backends/About-Buffer-Backends.rst","reviewed_on":"2026-10-17","review_after":"2027-01-15","covers":["references/communication.md"],"claims":["The .msg IDL is unchanged and implicit conversion keeps most vector code working; rosidl::Buffer is orthogonal to intra-process communication and loaned messages."]},
    {"id":"rclcpp-subscription-options-lyrical","url":"https://github.com/ros2/rclcpp/blob/lyrical/rclcpp/include/rclcpp/subscription_options.hpp","reviewed_on":"2026-10-18","review_after":"2027-01-16","covers":["references/communication.md"],"claims":["SubscriptionOptions::acceptable_buffer_backends is a std::string defaulting to \"cpu\" and is passed to rcl."]},
    {"id":"rosidl-buffer-lyrical","url":"https://github.com/ros2/rosidl/blob/lyrical/rosidl_buffer/include/rosidl_buffer/buffer.hpp","reviewed_on":"2026-10-18","review_after":"2027-01-16","covers":["references/communication.md","references/engineering-principles.md"],"claims":["rosidl::Buffer::get_backend_type() returns the backend of the held implementation; the buffer converts implicitly to a std::vector reference."]},
    {"id":"rosidl-generator-cpp-lyrical","url":"https://github.com/ros2/rosidl/blob/lyrical/rosidl_generator_cpp/rosidl_generator_cpp/__init__.py","reviewed_on":"2026-10-18","review_after":"2027-01-16","covers":["references/communication.md","references/engineering-principles.md"],"claims":["Only unbounded uint8[] sequences are generated as rosidl::Buffer; other unbounded sequences remain std::vector."]},
    {"id":"cuda-buffer-api","url":"https://github.com/ros2/rosidl_buffer_backends/blob/main/cuda_buffer_backend/cuda_buffer/include/cuda_buffer/cuda_buffer_api.hpp","reviewed_on":"2026-10-18","review_after":"2027-01-16","covers":["references/communication.md"],"claims":["cuda_buffer_backend provides allocate_buffer, from_output_buffer, from_input_buffer, and to_buffer; from_input_buffer copies host-to-device for a CPU-backed input, to_buffer copies, and from_output_buffer on a CPU-backed field returns a handle to a new device buffer."]}
  ]
}
